# Copy to .env for local dev (never commit real secrets).

# The bearer token clients must present on every /v1/* route.
BEARER_TOKEN=dev-local-token

# Optional real LLM provider (free tiers work: Google Gemini, Groq via OpenAI-compat).
# If unset, provider=llm jobs fail gracefully with a clear error (never crash).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=20
